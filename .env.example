# =================================================
# Weather Data Collector - 環境変数の設定例
# =================================================
# このファイルをコピーして .env.local を作成してください
# cp .env.example .env.local
#
# .env.local は .gitignore に含まれており、Gitにコミットされません
# =================================================

# -------------------------------------------------
# Supabase 設定（必須）
# -------------------------------------------------
# Supabase ダッシュボード → Settings → API から確認できます
# https://supabase.com/dashboard

# Project URL（例: https://xxxxxxxxxxxx.supabase.co）
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Service Role Key（絶対にフロントエンドに公開しないこと！）
# Supabase ダッシュボード → Settings → API → "service_role" キー
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# -------------------------------------------------
# 天気データ取得設定（任意）
# -------------------------------------------------

# モックデータを使用するか（true: モック, false: weathernews.jp実データ）
# ローカル開発中は true で動作確認することを推奨
USE_MOCK_DATA=true

# 取得対象の地域名（DBに保存される area カラムの値）
TARGET_AREA=千葉

# weathernews.jp の URL（千葉市の座標: 緯度35.6054, 経度140.1233）
# 別の地域に変更したい場合は座標を変更してください
WEATHERNEWS_URL=https://weathernews.jp/onebox/35.6054/140.1233/

# -------------------------------------------------
# Vercel Cron セキュリティ設定（任意・推奨）
# -------------------------------------------------
# Vercel Cron からのリクエストを認証するためのシークレット
# 設定する場合は、Vercel の環境変数にも同じ値を設定してください
# openssl rand -hex 32 などで生成したランダムな文字列を使ってください
CRON_SECRET=your-random-secret-here
